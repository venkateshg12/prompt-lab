{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "worker": "tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "sh -c 'prisma migrate dev \"$@\" && prisma generate' --",
    "db:ensure": "tsx src/scripts/ensure-database.ts",
    "db:studio": "prisma studio",
    "import-cases": "tsx src/scripts/import-cases.ts",
    "test": "vitest run",
    "db:seed-models": "tsx src/scripts/seed-models.ts",
    "bench": "tsx src/scripts/bench.ts",
    "export-run": "tsx src/scripts/export-run.ts",
    "test:int": "vitest run --config vitest.integration.config.mts",
    "promote-admin": "tsx src/scripts/promote-admin.ts",
    "readme:update": "tsx src/scripts/update-readme.ts",
    "readme:check": "tsx src/scripts/update-readme.ts --check"
  },
  "dependencies": {
    "@bull-board/api": "^8.1.2",
    "@bull-board/express": "^8.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@repo/scoring": "workspace:*",
    "@repo/types": "workspace:*",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.80.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^9.15.0",
    "googleapis": "^184",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8",
    "pino": "^10.4.0",
    "prisma": "7.10.1",
    "proxy-addr": "^2.0.8",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.3",
    "@types/pg": "^8",
    "@types/proxy-addr": "^2.0.3",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
