NODE_ENV=development
PORT=5000
# The web app origin(s), comma-separated.
CORS_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000
RUN_WORKERS_IN_API=true
LOG_LEVEL=debug
SERVICE_NAME=api
DATABASE_URL=postgresql://promptlab:promptlab@localhost:5432/promptlab
# Two DIFFERENT random secrets of at least 32 characters; the server refuses to start otherwise.
# Generate each with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth Web Client ID (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web),
# authorised JavaScript origin http://localhost:3000). A different client from the Gmail sender (Phase 08).
GOOGLE_CLIENT_ID=

REDIS_HOST=localhost
REDIS_PORT=6379
# Proxies whose client-IP headers may be believed (comma-separated CIDRs). Empty = trust no proxy.
TRUSTED_PROXY_CIDRS=
DEBUG_IP_ENDPOINT=false
DEMO_DAILY_CAP=500
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6380

# Gmail API sender (one-time authorization at http://localhost:5000/api/auth/gmail; blank = in-memory dev mailbox)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/auth/gmail/callback
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_NAME="Prompt Lab"
# Bull Board exposes job payloads (incl. tokens): off by default, Basic auth when on.
ENABLE_QUEUE_DASHBOARD=false
QUEUE_DASHBOARD_USER=
QUEUE_DASHBOARD_PASSWORD=
WORKER_PORT=8080
