# Prompt Lab API — environment. Grouped like the production checklist in docs/DEPLOY.md.
# Local development: copy to apps/api/.env and fill the two secrets. NEVER commit real values.

# ── Core ──────────────────────────────────────────────────────────────────────────────────────────
NODE_ENV=development                 # production on Render
PORT=5000
LOG_LEVEL=debug                      # info in production
SERVICE_NAME=api                     # prompt-lab-api in production

# ── Origins (exact, no trailing slash) ──────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000    # the web origin only, e.g. https://prompt-lab.vercel.app
CLIENT_URL=http://localhost:3000

# ── Database (PostgreSQL 17) ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://promptlab:promptlab@localhost:5432/promptlab
# Neon in production: DATABASE_URL = the POOLED url, DIRECT_DATABASE_URL = the direct one (migrations
# need it: the pooler can't hold migrate's advisory lock). Both with ?sslmode=require.
# DIRECT_DATABASE_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────────────────────────
# Two DIFFERENT random secrets of at least 32 characters; the server refuses to start otherwise.
# Generate each with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
# Google OAuth Web Client ID (APIs & Services -> Credentials -> OAuth client ID (Web)); authorised
# JavaScript origins: http://localhost:3000 and your production web origin. Not the Gmail sender client.
GOOGLE_CLIENT_ID=

# ── Redis ×2 ─────────────────────────────────────────────────────────────────────────────────────
# Queue + limits + pub/sub: maxmemory-policy MUST be noeviction (an evicted job is a run that never ends).
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# Response cache: volatile-lru, no persistence (an empty cache is a valid state).
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6380
# CACHE_REDIS_USERNAME=
# CACHE_REDIS_PASSWORD=
CACHE_ENABLED=true

# ── Proxy / limits ───────────────────────────────────────────────────────────────────────────────
# Proxies whose client-IP headers may be believed (comma-separated CIDRs). Empty = trust no proxy.
TRUSTED_PROXY_CIDRS=
DEBUG_IP_ENDPOINT=false              # true only while measuring TRUSTED_PROXY_CIDRS, then false
DEMO_DAILY_CAP=500                   # bring-your-own-key demo runs per day, all visitors

# ── Email (Gmail API sender; blank = in-memory dev mailbox, non-production only) ─────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/auth/gmail/callback
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_NAME="Prompt Lab"

# ── Models (a provider's models are enabled only when its key is set) ─────────────────────────────
# The API and the worker need the SAME keys.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# live (real providers) | replay (answers from REPLAY_DIR, CI) | fake (tests)
LLM_PROVIDER=live
REPLAY_DIR=
FAKE_LLM_SCRIPT=
FAKE_LLM_FIXTURES=
# "test" seeds only the fake:* models (integration and E2E tests).
MODELS_SEED=
# ANTHROPIC_BASE_URL / GEMINI_BASE_URL: only for pointing tests at a local stub

# ── Spend ────────────────────────────────────────────────────────────────────────────────────────
# true in production: only platform admins (promote-admin) may start runs on the server's keys.
OWNER_RUNS_REQUIRE_ADMIN=false
CELL_BACKOFF_MS=5000

# ── Workers ──────────────────────────────────────────────────────────────────────────────────────
# true = the API process also runs the queue workers (Render free tier); false = a separate worker service.
RUN_WORKERS_IN_API=true
WORKER_PORT=8080
# Bull Board exposes job payloads: off in production. When on, Basic auth is required.
ENABLE_QUEUE_DASHBOARD=false
QUEUE_DASHBOARD_USER=
QUEUE_DASHBOARD_PASSWORD=
