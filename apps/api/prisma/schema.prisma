// Prompt Lab's data model on PostgreSQL. Every tenant-owned table carries `org_id` (a workspace is
// an org); the tenant extension in src/db/prisma.ts scopes every query to the caller's workspace
// (TENANT_MODELS there). Full target model: docs/reference/data-model.md.
//
// Conventions
// - Ids are UUIDv7 (`uuid(7)`): unique and time-ordered, so (created_at, id) cursors stay cheap.
// - Tables and columns are snake_case in the database; Prisma fields stay camelCase.
// - Model cost is integer micro-dollars; running totals that can pass 2^31 are BigInt.
// - Raw model output is stored exactly as returned. Nothing here repairs it.
// - No TTL indexes: expiring rows carry expires_at, reads check it, purge-expired deletes them.
// - Copied models keep PaperTrail's names. Rename nothing for style.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────────────────────────────

enum AuthProvider {
  local
  google
}

enum PlatformRole {
  user
  admin
}

enum OrgRole {
  owner
  admin
  reviewer
  viewer
}

enum InviteRole {
  admin
  reviewer
  viewer
}

enum Technique {
  zero_shot
  few_shot
  cot
  structured
  custom
}

enum Provider {
  nvidia
  openai
  anthropic
  gemini
  fake
}

enum StructuredSupport {
  supported
  unsupported
  untested
}

enum RunStatus {
  queued
  running
  completed
  failed
  cancelled
}

enum ResultStatus {
  scored
  error
  skipped
}

enum Split {
  dev
  test
}

enum ActorType {
  user
  api_key
  system
}

// ── Identity (Phase 04) ──────────────────────────────────────────────────────────────────────────

model User {
  id           String       @id @default(uuid(7)) @db.Uuid
  name         String?
  // Normalised to lower case on write, so "Foo@x.com" and "foo@x.com" can't become two accounts.
  email        String       @unique
  // bcrypt hash. Null only for Google accounts.
  password     String?
  googleId     String?      @unique @map("google_id")
  authProvider AuthProvider @default(local) @map("auth_provider")
  avatar       String?
  role         PlatformRole @default(user)
  verified     Boolean      @default(false)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions          Session[]
  verificationLinks VerificationLink[]
  memberships       Membership[]
  orgsCreated       Org[]              @relation("OrgCreatedBy")
  invitesSent       Invite[]           @relation("InviteInvitedBy")

  @@map("users")
}

model Session {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  // Refresh-token rotation: only the jti issued last is valid; the previous one is honoured for a
  // short grace window so two tabs refreshing at the same moment don't revoke the session.
  refreshJti     String?   @map("refresh_jti")
  prevRefreshJti String?   @map("prev_refresh_jti")
  rotatedAt      DateTime? @map("rotated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationLink {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  token     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("verification_links")
}

// ── Tenancy (Phase 10) ───────────────────────────────────────────────────────────────────────────

model Org {
  id                     String   @id @default(uuid(7)) @db.Uuid
  name                   String
  createdById            String   @map("created_by") @db.Uuid
  // Owner-key model spend per calendar month (UTC). Read by the runner (Phase 17).
  monthlyBudgetUsdMicros BigInt   @default(20000000) @map("monthly_budget_usd_micros")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   User         @relation("OrgCreatedBy", fields: [createdById], references: [id])
  memberships Membership[]
  invites     Invite[]
  tasks       Task[]

  @@map("orgs")
}

model Membership {
  id        String   @id @default(uuid(7)) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      OrgRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One membership per (org, user); also the lookup index for resolveOrg.
  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invite {
  id          String     @id @default(uuid(7)) @db.Uuid
  orgId       String     @map("org_id") @db.Uuid
  email       String
  role        InviteRole
  tokenHash   String     @unique @map("token_hash")
  invitedById String     @map("invited_by") @db.Uuid
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  org       Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User @relation("InviteInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([orgId, email])
  @@index([expiresAt])
  @@map("invites")
}

model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id")
  action     String
  targetType String    @map("target_type")
  targetId   String    @map("target_id")
  diff       Json?
  at         DateTime  @default(now()) @db.Timestamptz(3)

  @@index([orgId, at(sort: Desc)])
  @@index([orgId, targetId, at(sort: Desc)])
  @@map("audit_logs")
}

// ── Tasks and test sets (Phases 11–12) ───────────────────────────────────────────────────────────

model Task {
  id           String   @id @default(uuid(7)) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  slug         String // "job-postings"
  name         String
  description  String   @default("")
  instructions String // the shared {{instructions}} block
  fields       Json // FieldRule[] (the DSL, scoring-rules.md §2)
  version      Int      @default(1) // bumped when instructions or fields change; runs record it
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  org      Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  examples Example[]
  prompts  PromptVersion[]
  runs     Run[]

  @@unique([orgId, slug])
  @@map("tasks")
}

model Example {
  id              String   @id @default(uuid(7)) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  ref             String // "jp_017": stable, exported as exampleId
  split           Split
  tags            String[] @default([])
  input           String
  expected        Json
  publicInput     Boolean  @default(true) @map("public_input") // false → hidden on published pages
  secondLabel     Json?    @map("second_label") // the double-check
  secondLabelById String?  @map("second_label_by") @db.Uuid
  notes           String?
  revision        Int      @default(1) // bumped on every expected/input edit
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  results Result[]

  @@unique([taskId, ref])
  @@index([taskId, split])
  @@map("examples")
}

// ── Prompts (Phase 13) ───────────────────────────────────────────────────────────────────────────

model PromptVersion {
  id                String    @id @default(uuid(7)) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  taskId            String    @map("task_id") @db.Uuid
  key               String // "v2-few-shot"
  version           Int // exported as "<key>@<version>"
  technique         Technique
  system            String
  template          String // contains {{input}}, may use {{instructions}} {{fields}} {{examples}}
  fewShotExampleIds String[]  @default([]) @map("few_shot_example_ids") @db.Uuid // dev examples only (enforced)
  notes             String?
  frozenAt          DateTime? @map("frozen_at") @db.Timestamptz(3) // set when first used by a run; then immutable
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  variants RunVariant[]

  @@unique([taskId, key, version])
  @@map("prompt_versions")
}

// ── Model registry (Phase 14) ────────────────────────────────────────────────────────────────────

// Global registry, not tenant-owned: configuration shared by every workspace.
model Model {
  id                     String            @id @default(uuid(7)) @db.Uuid
  key                    String            @unique // "nvidia:openai/gpt-oss-20b"
  provider               Provider
  modelId                String            @map("model_id")
  label                  String
  contextTokens          Int?              @map("context_tokens")
  inputUsdMicrosPerMTok  Int               @map("input_usd_micros_per_mtok")
  outputUsdMicrosPerMTok Int               @map("output_usd_micros_per_mtok")
  priceNote              String?           @map("price_note") // "reference host price; NVIDIA free tier"
  priceCheckedOn         DateTime          @map("price_checked_on") @db.Date
  structured             StructuredSupport @default(untested)
  structuredMode         String?           @map("structured_mode") // "native" | "guided_json" (Phase 15 probe)
  structuredProbedAt     DateTime?         @map("structured_probed_at") @db.Timestamptz(3)
  active                 Boolean           @default(true) // false = retired (410) or removed

  variants RunVariant[]

  @@map("models")
}

// ── Runs and results (Phase 17) ──────────────────────────────────────────────────────────────────

model Run {
  id              String    @id @default(uuid(7)) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  taskId          String    @map("task_id") @db.Uuid
  taskVersion     Int       @map("task_version")
  split           Split
  repeats         Int       @default(1)
  temperature     Float     @default(0)
  status          RunStatus @default(queued)
  datasetHash     String    @map("dataset_hash") // sha256 of the examples' (ref, revision) list
  testReused      Boolean   @default(false) @map("test_reused")
  pricesSnapshot  Json      @map("prices_snapshot")
  promptSnapshots Json      @map("prompt_snapshots") // rendered system/turns/schema per variant, written by createRun
  totalCells      Int       @map("total_cells")
  doneCells       Int       @default(0) @map("done_cells")
  errorCells      Int       @default(0) @map("error_cells")
  notes           String?
  startedById     String    @map("started_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // Moves with every counter update: the stale-run sweeper looks for runs that stopped progressing.
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(3)
  // Phase 22: a published run is public and read-only at /r/<publishedSlug> (r_ + 10 base62, unguessable).
  publishedSlug   String?   @unique @map("published_slug")
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(3)
  publishOptions  Json?     @map("publish_options") // { title, includeNotes }

  task     Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  variants RunVariant[]
  results  Result[]

  @@index([orgId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("runs")
}

// One prompt version x one model in a run.
model RunVariant {
  id              String @id @default(uuid(7)) @db.Uuid
  orgId           String @map("org_id") @db.Uuid
  runId           String @map("run_id") @db.Uuid
  promptVersionId String @map("prompt_version_id") @db.Uuid
  modelId         String @map("model_id") @db.Uuid
  summary         Json? // aggregates (scoring-rules.md §3), written by finalize (Phase 18)

  run           Run           @relation(fields: [runId], references: [id], onDelete: Cascade)
  promptVersion PromptVersion @relation(fields: [promptVersionId], references: [id])
  model         Model         @relation(fields: [modelId], references: [id])
  results       Result[]

  @@unique([runId, promptVersionId, modelId])
  @@map("run_variants")
}

model Result {
  id            String       @id @default(uuid(7)) @db.Uuid
  orgId         String       @map("org_id") @db.Uuid
  runId         String       @map("run_id") @db.Uuid
  variantId     String       @map("variant_id") @db.Uuid
  exampleId     String       @map("example_id") @db.Uuid
  repeatIndex   Int          @map("repeat_index")
  status        ResultStatus
  rawOutput     String?      @map("raw_output")
  extractedText String?      @map("extracted_text")
  parsedJson    Json?        @map("parsed_json")
  validJson     Boolean?     @map("valid_json")
  schemaValid   Boolean?     @map("schema_valid")
  fieldScores   Json?        @map("field_scores") // [{ key, score, reason }]
  fieldDetails  Json?        @map("field_details") // { skills: { precision, recall }, ... }
  overallScore  Float?       @map("overall_score")
  exactMatch    Boolean?     @map("exact_match")
  inputTokens   Int?         @map("input_tokens")
  outputTokens  Int?         @map("output_tokens")
  costUsdMicros Int?         @map("cost_usd_micros")
  latencyMs     Int?         @map("latency_ms")
  finishReason  String?      @map("finish_reason")
  attempts      Int          @default(1)
  error         String? // also skip reasons: "structured_unsupported", "cancelled"
  judge         Json? // Phase 26: the LLM judge's verdict, apart from the scores (StoredJudge in @repo/types)
  completedAt   DateTime     @default(now()) @map("completed_at") @db.Timestamptz(3)

  run     Run        @relation(fields: [runId], references: [id], onDelete: Cascade)
  variant RunVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  example Example    @relation(fields: [exampleId], references: [id])

  @@unique([runId, variantId, exampleId, repeatIndex]) // one result per cell, even on retries
  @@index([runId, variantId, overallScore])
  @@map("results")
}
