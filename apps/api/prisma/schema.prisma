// Prompt Lab's data model on PostgreSQL. Every tenant-owned table carries `org_id` (a workspace is
// an org); the tenant extension in src/db/prisma.ts scopes every query to the caller's workspace
// (TENANT_MODELS there). Full target model: docs/reference/data-model.md.
//
// Conventions
// - Ids are UUIDv7 (`uuid(7)`): unique and time-ordered, so (created_at, id) cursors stay cheap.
// - Tables and columns are snake_case in the database; Prisma fields stay camelCase.
// - Model cost is integer micro-dollars; running totals that can pass 2^31 are BigInt.
// - Raw model output is stored exactly as returned. Nothing here repairs it.
// - No TTL indexes: expiring rows carry expires_at, reads check it, purge-expired deletes them.
// - Copied models keep PaperTrail's names. Rename nothing for style.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────────────────────────────

enum AuthProvider {
  local
  google
}

enum PlatformRole {
  user
  admin
}

enum OrgRole {
  owner
  admin
  reviewer
  viewer
}

enum InviteRole {
  admin
  reviewer
  viewer
}

enum Technique {
  zero_shot
  few_shot
  cot
  structured
  custom
}

enum Provider {
  nvidia
  openai
  anthropic
  gemini
  fake
}

enum StructuredSupport {
  supported
  unsupported
  untested
}

enum Split {
  dev
  test
}

enum ActorType {
  user
  api_key
  system
}

// ── Identity (Phase 04) ──────────────────────────────────────────────────────────────────────────

model User {
  id           String       @id @default(uuid(7)) @db.Uuid
  name         String?
  // Normalised to lower case on write, so "Foo@x.com" and "foo@x.com" can't become two accounts.
  email        String       @unique
  // bcrypt hash. Null only for Google accounts.
  password     String?
  googleId     String?      @unique @map("google_id")
  authProvider AuthProvider @default(local) @map("auth_provider")
  avatar       String?
  role         PlatformRole @default(user)
  verified     Boolean      @default(false)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions          Session[]
  verificationLinks VerificationLink[]
  memberships       Membership[]
  orgsCreated       Org[]              @relation("OrgCreatedBy")
  invitesSent       Invite[]           @relation("InviteInvitedBy")

  @@map("users")
}

model Session {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  // Refresh-token rotation: only the jti issued last is valid; the previous one is honoured for a
  // short grace window so two tabs refreshing at the same moment don't revoke the session.
  refreshJti     String?   @map("refresh_jti")
  prevRefreshJti String?   @map("prev_refresh_jti")
  rotatedAt      DateTime? @map("rotated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationLink {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  token     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("verification_links")
}

// ── Tenancy (Phase 10) ───────────────────────────────────────────────────────────────────────────

model Org {
  id                     String   @id @default(uuid(7)) @db.Uuid
  name                   String
  createdById            String   @map("created_by") @db.Uuid
  // Owner-key model spend per calendar month (UTC). Read by the runner (Phase 17).
  monthlyBudgetUsdMicros BigInt   @default(20000000) @map("monthly_budget_usd_micros")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   User         @relation("OrgCreatedBy", fields: [createdById], references: [id])
  memberships Membership[]
  invites     Invite[]
  tasks       Task[]

  @@map("orgs")
}

model Membership {
  id        String   @id @default(uuid(7)) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      OrgRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One membership per (org, user); also the lookup index for resolveOrg.
  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invite {
  id          String     @id @default(uuid(7)) @db.Uuid
  orgId       String     @map("org_id") @db.Uuid
  email       String
  role        InviteRole
  tokenHash   String     @unique @map("token_hash")
  invitedById String     @map("invited_by") @db.Uuid
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  org       Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User @relation("InviteInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([orgId, email])
  @@index([expiresAt])
  @@map("invites")
}

model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id")
  action     String
  targetType String    @map("target_type")
  targetId   String    @map("target_id")
  diff       Json?
  at         DateTime  @default(now()) @db.Timestamptz(3)

  @@index([orgId, at(sort: Desc)])
  @@index([orgId, targetId, at(sort: Desc)])
  @@map("audit_logs")
}

// ── Tasks and test sets (Phases 11–12) ───────────────────────────────────────────────────────────

model Task {
  id           String   @id @default(uuid(7)) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  slug         String // "job-postings"
  name         String
  description  String   @default("")
  instructions String // the shared {{instructions}} block
  fields       Json // FieldRule[] (the DSL, scoring-rules.md §2)
  version      Int      @default(1) // bumped when instructions or fields change; runs record it
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  org      Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  examples Example[]
  prompts  PromptVersion[]
  // Phase 17: runs

  @@unique([orgId, slug])
  @@map("tasks")
}

model Example {
  id              String   @id @default(uuid(7)) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  ref             String // "jp_017": stable, exported as exampleId
  split           Split
  tags            String[] @default([])
  input           String
  expected        Json
  publicInput     Boolean  @default(true) @map("public_input") // false → hidden on published pages
  secondLabel     Json?    @map("second_label") // the double-check
  secondLabelById String?  @map("second_label_by") @db.Uuid
  notes           String?
  revision        Int      @default(1) // bumped on every expected/input edit
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Phase 17: results Result[]

  @@unique([taskId, ref])
  @@index([taskId, split])
  @@map("examples")
}

// ── Prompts (Phase 13) ───────────────────────────────────────────────────────────────────────────

model PromptVersion {
  id                String    @id @default(uuid(7)) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  taskId            String    @map("task_id") @db.Uuid
  key               String // "v2-few-shot"
  version           Int // exported as "<key>@<version>"
  technique         Technique
  system            String
  template          String // contains {{input}}, may use {{instructions}} {{fields}} {{examples}}
  fewShotExampleIds String[]  @default([]) @map("few_shot_example_ids") @db.Uuid // dev examples only (enforced)
  notes             String?
  frozenAt          DateTime? @map("frozen_at") @db.Timestamptz(3) // set when first used by a run; then immutable
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Phase 17: variants RunVariant[]

  @@unique([taskId, key, version])
  @@map("prompt_versions")
}

// ── Model registry (Phase 14) ────────────────────────────────────────────────────────────────────

// Global registry, not tenant-owned: configuration shared by every workspace.
model Model {
  id                     String            @id @default(uuid(7)) @db.Uuid
  key                    String            @unique // "nvidia:openai/gpt-oss-20b"
  provider               Provider
  modelId                String            @map("model_id")
  label                  String
  contextTokens          Int?              @map("context_tokens")
  inputUsdMicrosPerMTok  Int               @map("input_usd_micros_per_mtok")
  outputUsdMicrosPerMTok Int               @map("output_usd_micros_per_mtok")
  priceNote              String?           @map("price_note") // "reference host price; NVIDIA free tier"
  priceCheckedOn         DateTime          @map("price_checked_on") @db.Date
  structured             StructuredSupport @default(untested)
  structuredMode         String?           @map("structured_mode") // "native" | "guided_json" (Phase 15 probe)
  structuredProbedAt     DateTime?         @map("structured_probed_at") @db.Timestamptz(3)
  active                 Boolean           @default(true) // false = retired (410) or removed

  // Phase 17: variants RunVariant[]

  @@map("models")
}
